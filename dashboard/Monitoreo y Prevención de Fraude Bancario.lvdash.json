{
  "datasets": [
    {
      "name": "fraude_main",
      "displayName": "Fraude - Datos Principales",
      "queryLines": [
        "SELECT\n",
        "  transaccion_id,\n",
        "  departamento,\n",
        "  banco_principal AS banco,\n",
        "  monto_operacion AS monto_soles,\n",
        "  score_riesgo,\n",
        "  nivel_riesgo,\n",
        "  prioridad_atencion,\n",
        "  estado_fraude,\n",
        "  ingestion_date_gold\n",
        "FROM\n",
        "  catalog_au.golden.golden_analisis_fraude\n",
        "WHERE\n",
        "  (\n",
        "    :banco IS NULL\n",
        "    OR CARDINALITY(:banco) = 0\n",
        "    OR array_contains(:banco, banco_principal)\n",
        "  )\n",
        "  AND (\n",
        "    :departamento IS NULL\n",
        "    OR CARDINALITY(:departamento) = 0\n",
        "    OR array_contains(:departamento, departamento)\n",
        "  )\n",
        "  AND (\n",
        "    :nivel_riesgo IS NULL\n",
        "    OR CARDINALITY(:nivel_riesgo) = 0\n",
        "    OR array_contains(:nivel_riesgo, nivel_riesgo)\n",
        "  )\n",
        "  AND (\n",
        "    :prioridad IS NULL\n",
        "    OR CARDINALITY(:prioridad) = 0\n",
        "    OR array_contains(:prioridad, prioridad_atencion)\n",
        "  )"
      ],
      "parameters": [
        {
          "displayName": "Banco",
          "keyword": "banco",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING"
            }
          }
        },
        {
          "displayName": "Departamento",
          "keyword": "departamento",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING"
            }
          }
        },
        {
          "displayName": "Nivel de Riesgo",
          "keyword": "nivel_riesgo",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING"
            }
          }
        },
        {
          "displayName": "Prioridad de Atención",
          "keyword": "prioridad",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING"
            }
          }
        }
      ],
      "columns": [
        {
          "displayName": "pct_fraude",
          "description": "Porcentaje de transacciones en Revisión Inmediata (estado_fraude) sobre el total",
          "expression": "COUNT_IF(`estado_fraude` = 'Revisión Inmediata') * 100.0 / COUNT(*)"
        }
      ]
    }
  ],
